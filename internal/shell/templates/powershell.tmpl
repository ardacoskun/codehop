# codehop shell integration for PowerShell, generated by `codehop init powershell`.
# Load it from your profile ($PROFILE):
#   Invoke-Expression (& { (codehop init powershell | Out-String) })

$global:__codehop_exe = Get-Command codehop -CommandType Application -ErrorAction SilentlyContinue |
    Select-Object -First 1 -ExpandProperty Source
if (-not $global:__codehop_exe) {
    Write-Warning 'codehop is not on PATH; the codehop shell integration was not loaded.'
} else {

# Runs codehop with UTF-8 output decoding (Windows PowerShell 5.1 defaults to
# the OEM code page, which garbles non-ASCII project names and paths).
function global:__codehop_run {
    # Hosts without a console (ISE, some editor terminals) reject the
    # assignment; codehop still works there, only non-ASCII names may suffer.
    $saved = $null
    try {
        $saved = [Console]::OutputEncoding
        [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
    } catch { $saved = $null }
    try {
        & $global:__codehop_exe @args
    } finally {
        if ($null -ne $saved) { try { [Console]::OutputEncoding = $saved } catch { } }
    }
}

# Resolves a project (picker when ambiguous or empty) and returns its path.
function global:__codehop_query {
    $dir = __codehop_run query --record @args
    if ($LASTEXITCODE -eq 0 -and $dir) { return $dir }
}

# Completion results are always single-quoted. PowerShell treats the
# typographic quotes ‘ ’ ‚ ‛ like ', so all of them are doubled.
$global:__codehop_completer = {
    param($wordToComplete, $commandAst, $cursorPosition)
    if ($commandAst.CommandElements.Count -gt 2 -or
        ($commandAst.CommandElements.Count -eq 2 -and -not $wordToComplete)) { return }
    $quotes = "['" + [char]0x2018 + [char]0x2019 + [char]0x201A + [char]0x201B + "]"
    __codehop_run list --describe "--query=$wordToComplete" 2>$null | ForEach-Object {
        $name, $desc = $_ -split "`t", 2
        if (-not $desc) { $desc = $name }
        $text = if ($name -match '^[A-Za-z0-9._/\\-]+$') { $name } else { "'" + ($name -replace $quotes, '$0$0') + "'" }
        [System.Management.Automation.CompletionResult]::new($text, $name, 'ParameterValue', $desc)
    }
}
{{- if .Cmd}}

# {{.Cmd}} <project>: open a project; paths and flags go to the editor unchanged.
Remove-Item Alias:{{.Cmd}} -Force -ErrorAction SilentlyContinue
function global:{{.Cmd}} { & $global:__codehop_exe wrap @args }
Register-ArgumentCompleter -Native -CommandName {{.Cmd}} -ScriptBlock $global:__codehop_completer
{{- end}}
{{- if .CdCmd}}

# {{.CdCmd}} <project>: cd into a project.
Remove-Item Alias:{{.CdCmd}} -Force -ErrorAction SilentlyContinue
function global:{{.CdCmd}} {
    $dir = __codehop_query @args
    if ($dir) { Set-Location -LiteralPath $dir }
}
Register-ArgumentCompleter -Native -CommandName {{.CdCmd}} -ScriptBlock $global:__codehop_completer
{{- end}}
{{- range .Actions}}

# {{.Name}} <project> [args]: cd into a project and run the [actions] command.
Remove-Item Alias:{{.Name}} -Force -ErrorAction SilentlyContinue
function global:{{.Name}} {
    $rest = @($args | Select-Object -Skip 1)
    $dir = if ($args.Count -gt 0) { __codehop_query $args[0] } else { __codehop_query }
    if (-not $dir) { return }
    Set-Location -LiteralPath $dir
    {{.Command}} @rest
}
Register-ArgumentCompleter -Native -CommandName {{.Name}} -ScriptBlock $global:__codehop_completer
{{- end}}
}
