# codehop shell integration for fish, generated by `codehop init fish`.
# Load it from ~/.config/fish/config.fish:
#   codehop init fish | source

function __codehop_first_arg
    test (count (commandline -opc)) -eq 1
end
{{- if .Cmd}}

# {{.Cmd}} <project>: open a project; paths and flags go to the editor unchanged.
function {{.Cmd}}
    command codehop wrap $argv
end
complete -c {{.Cmd}} -n __codehop_first_arg -a '(command codehop list --describe 2>/dev/null)'
{{- end}}
{{- if .CdCmd}}

# {{.CdCmd}} <project>: cd into a project.
function {{.CdCmd}}
    set -l __codehop_dir (command codehop query --record -- $argv); or return
    builtin cd -- $__codehop_dir
end
{{- end}}
{{- range .Actions}}

# {{.Name}} <project> [args]: cd into a project and run the [actions] command.
function {{.Name}}
    set -l __codehop_dir (command codehop query --record -- $argv[1]); or return
    builtin cd -- $__codehop_dir; or return
    set -e argv[1]
    {{.Command}} $argv
end
{{- end}}
{{- range .CompleteNames}}
complete -c {{.}} -f -n __codehop_first_arg -a '(command codehop list --describe 2>/dev/null)'
{{- end}}
