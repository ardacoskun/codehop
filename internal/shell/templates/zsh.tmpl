# codehop shell integration for zsh, generated by `codehop init zsh`.
# Load it from ~/.zshrc after compinit:
#   eval "$(codehop init zsh)"

# Completes project names. Prefix matches complete normally; when nothing
# starts with the typed text, codehop returns fuzzy matches and -U lets them
# replace the word ("shuf<Tab>" → "color-shuffle").
function __codehop_complete_projects {
  local line p
  local -a names projects
  for line in "${(@f)$(command codehop list --describe --query="$PREFIX" 2>/dev/null)}"; do
    [[ -n $line ]] || continue
    names+=("${line%%$'\t'*}")
    projects+=("${${line%%$'\t'*}//:/\\:}:${line#*$'\t'}")
  done
  (( ${#names} )) || return 1
  for p in "${names[@]}"; do
    if [[ ${(L)p} == "${(L)PREFIX}"* ]]; then
      _describe -t projects 'project' projects
      return
    fi
  done
  # Fuzzy matches: -U replaces the typed word instead of filtering by it.
  # Several of them share no useful prefix, so start menu completion
  # (Tab cycles) rather than erasing what was typed.
  local expl
  _wanted projects expl 'project' compadd -U -a names
  (( ${#names} > 1 )) && compstate[insert]=menu
  return 0
}

function __codehop_complete_open {
  if (( CURRENT == 2 )); then
    local ret=1
    __codehop_complete_projects && ret=0
    _files && ret=0
    return ret
  fi
  _files
}

function __codehop_complete_first {
  if (( CURRENT == 2 )); then
    __codehop_complete_projects
  else
    _files
  fi
}
{{- if .Cmd}}

# {{.Cmd}} <project>: open a project; paths and flags go to the editor unchanged.
unalias {{.Cmd}} 2>/dev/null || true
function {{.Cmd}} {
  command codehop wrap "$@"
}
{{- end}}
{{- if .CdCmd}}

# {{.CdCmd}} <project>: cd into a project.
unalias {{.CdCmd}} 2>/dev/null || true
function {{.CdCmd}} {
  local __codehop_dir
  __codehop_dir="$(command codehop query --record -- "$@")" && builtin cd -- "$__codehop_dir"
}
{{- end}}
{{- range .Actions}}

# {{.Name}} <project> [args]: cd into a project and run the [actions] command.
unalias {{.Name}} 2>/dev/null || true
function {{.Name}} {
  local __codehop_dir
  __codehop_dir="$(command codehop query --record -- ${1:+"$1"})" || return
  (( $# )) && shift
  builtin cd -- "$__codehop_dir" || return
  {{.Command}} "$@"
}
{{- end}}

{{- if .AllNames}}

# Inline suggestion for zsh-autosuggestions: typing "code col" shows
# "code color-shuffle" greyed out (→ accepts it). Only prefix matches are
# suggested, most frecent first; other command lines fall through to the
# user's own strategies.
function _zsh_autosuggest_strategy_codehop {
  emulate -L zsh
  typeset -g suggestion=
  [[ $1 == *' '* ]] || return
  local cmd=${1%% *} word=${1#* }
  [[ -n $word && $word != *' '* ]] || return
  case $cmd in
    ({{join .AllNames "|"}}) ;;
    (*) return ;;
  esac
  local -a matches
  matches=("${(@f)$(command codehop list --names --query="$word" 2>/dev/null)}")
  [[ -n ${matches[1]} && ${matches[1]} == "$word"* ]] && suggestion="$cmd ${matches[1]}"
  return 0
}
if (( ! ${ZSH_AUTOSUGGEST_STRATEGY[(Ie)codehop]:-0} )); then
  typeset -ga ZSH_AUTOSUGGEST_STRATEGY
  ZSH_AUTOSUGGEST_STRATEGY=(codehop ${ZSH_AUTOSUGGEST_STRATEGY[@]:-history})
fi
{{- end}}

if (( $+functions[compdef] )); then
{{- if .Cmd}}
  compdef __codehop_complete_open {{.Cmd}}
{{- end}}
{{- if .CompleteNames}}
  compdef __codehop_complete_first {{join .CompleteNames " "}}
{{- end}}
  # Keep codehop's frecency order instead of sorting alphabetically.
  zstyle ':completion:*:*:*:*:projects' sort false
fi
